# Copy to .env (repo root) and fill in. NEVER commit .env.
# The API reads ../../.env when run from apps/api, or real env vars in production (Vercel project settings).

# --- Database ---
# Local docker:  postgresql+psycopg://baton:baton@localhost:5433/baton
# Neon (prod):   use the *pooled* endpoint (host contains "-pooler"), e.g.
#                postgresql+psycopg://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/baton?sslmode=require
DATABASE_URL=postgresql+psycopg://baton:baton@localhost:5433/baton
# Production (Neon pooled URL). Used only explicitly, e.g. for migrations: DATABASE_URL="$PROD_DATABASE_URL" uv run alembic upgrade head
PROD_DATABASE_URL=

# --- GitHub (fine-grained token, public repositories read-only; raises the REST rate limit) ---
GITHUB_TOKEN=

# --- LLM ---
LLM_PROVIDER=gemini           # gemini | groq: provider for bare model names in the chains below
LLM_API_KEY=                  # optional single key for LLM_PROVIDER (joins that provider's pool)
GEMINI_API_KEYS=              # comma-separated key pool; calls rotate across keys
GROQ_API_KEYS=                # comma-separated key pool (OpenAI-compatible Groq API)
# Fallback chains: comma-separated `provider:model` (or bare model = LLM_PROVIDER). Left to right; a model whose keys
# are all out of quota hands over to the next entry. Check model names against each provider's current model list.
LLM_MODEL_EXTRACT=            # e.g. gemini:gemini-3.5-flash,gemini:gemini-3.1-flash-lite,groq:llama-3.3-70b-versatile
LLM_MODEL_VERIFY=             # e.g. gemini:gemini-3.5-flash-lite,groq:llama-3.1-8b-instant
VERIFIER=llm                  # llm | nli (nli needs >= 2 GB RAM; not used on Vercel)
EMBEDDINGS=off                # off | fastembed

# --- App ---
SESSION_SECRET=change-me      # random string used to sign the visitor cookie
CUSTOM_WORKSPACE_DAILY_LIMIT=3
PIPELINE_SLICE_SECONDS=45     # max work per POST /runs/{id}/advance call (Vercel cap is 300 s)
CORS_ORIGINS=http://localhost:3000   # only needed locally; prod is same-origin via the Next.js rewrite

# --- Web (apps/web) ---
API_ORIGIN=http://localhost:8000     # target of the /api/* rewrite; in prod = the API Vercel project URL

# Daily sandbox clean-up (Vercel cron sends Authorization: Bearer $CRON_SECRET)
CRON_SECRET=
