# Copy to .env (repo root) and fill in. NEVER commit .env.
# The API reads ../../.env when run from apps/api, or real env vars in production (Vercel project settings).

# --- Database ---
# Local docker:  postgresql+psycopg://baton:baton@localhost:5432/baton
# Neon (prod):   use the *pooled* endpoint (host contains "-pooler"), e.g.
#                postgresql+psycopg://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/baton?sslmode=require
DATABASE_URL=postgresql+psycopg://baton:baton@localhost:5432/baton

# --- GitHub (fine-grained token, public repositories read-only; raises the REST rate limit) ---
GITHUB_TOKEN=

# --- LLM ---
LLM_PROVIDER=anthropic        # anthropic | openai | gemini
LLM_API_KEY=
LLM_MODEL_EXTRACT=            # a capable model, used for claim extraction
LLM_MODEL_VERIFY=             # a smaller/faster model, used for the isolated verifier + checklist coverage
VERIFIER=llm                  # llm | nli (nli needs >= 2 GB RAM; not used on Vercel)
EMBEDDINGS=off                # off | fastembed

# --- App ---
SESSION_SECRET=change-me      # random string used to sign the visitor cookie
CUSTOM_WORKSPACE_DAILY_LIMIT=3
PIPELINE_SLICE_SECONDS=45     # max work per POST /runs/{id}/advance call (Vercel cap is 300 s)
CORS_ORIGINS=http://localhost:3000   # only needed locally; prod is same-origin via the Next.js rewrite

# --- Web (apps/web) ---
API_ORIGIN=http://localhost:8000     # target of the /api/* rewrite; in prod = the API Vercel project URL
